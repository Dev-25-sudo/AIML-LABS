import numpy as np
import matplotlib.pyplot as plt
from tqdm import tqdm
from sklearn.metrics import confusion_matrix, classification_report, precision_recall_fscore_support
from sklearn.manifold import TSNE
from sklearn.decomposition import PCA
from tensorflow.keras.datasets import mnist
import seaborn as sns
sns.set(style="whitegrid")

def one_hot(y, num_classes):
    return np.eye(num_classes)[y]

def accuracy(y_true, y_pred):
    return np.mean(y_true == y_pred)

def he_init(in_dim, out_dim):
    return np.random.randn(in_dim, out_dim) * np.sqrt(2.0 / in_dim)

def xavier_init(in_dim, out_dim):
    return np.random.randn(in_dim, out_dim) * np.sqrt(1.0 / in_dim)


def relu(Z):
    return np.maximum(0, Z)

def relu_deriv(Z):
    return (Z > 0).astype(float)

def sigmoid(Z):
    return 1 / (1 + np.exp(-Z))

def sigmoid_deriv(A):
    return A * (1 - A)

def softmax(Z):
    Z = Z - np.max(Z, axis=1, keepdims=True)
    exp = np.exp(Z)
    return exp / np.sum(exp, axis=1, keepdims=True)

class AdamOptimizer:
    def __init__(self, params, lr=0.001, beta1=0.9, beta2=0.999, eps=1e-8):
        self.lr = lr
        self.beta1 = beta1
        self.beta2 = beta2
        self.eps = eps
        self.m = {k: np.zeros_like(v) for k,v in params.items()}
        self.v = {k: np.zeros_like(v) for k,v in params.items()}
        self.t = 0

    def step(self, params, grads):
        self.t += 1
        updates = {}
        for k in params.keys():
            self.m[k] = self.beta1 * self.m[k] + (1 - self.beta1) * grads[k]
            self.v[k] = self.beta2 * self.v[k] + (1 - self.beta2) * (grads[k]**2)
            m_hat = self.m[k] / (1 - self.beta1**self.t)
            v_hat = self.v[k] / (1 - self.beta2**self.t)
            update = self.lr * m_hat / (np.sqrt(v_hat) + self.eps)
            params[k] -= update
            updates[k] = update
        return updates

print("Loading MNIST...")
(X_train, y_train), (X_test, y_test) = mnist.load_data()
X_train = X_train.reshape(-1, 28*28).astype(np.float32) / 255.0
X_test  = X_test.reshape(-1, 28*28).astype(np.float32) / 255.0

num_classes = 10
Y_train = one_hot(y_train, num_classes)
Y_test  = one_hot(y_test, num_classes)

print("Shapes:", X_train.shape, Y_train.shape, X_test.shape, Y_test.shape)

input_dim = 784
layers_dims = [input_dim, 256, 128, 64, 32, num_classes]
dropout_rates = [0.2, 0.2, 0.2, 0.2]

epochs = 30
batch_size = 128
initial_lr = 0.001
l2_lambda = 1e-4
early_stopping_patience = 5
use_dropout = True
use_lr_scheduler = True
reduce_factor = 0.5
min_lr = 1e-6

np.random.seed(42)
params = {}
num_layers = len(layers_dims) - 1
for i in range(num_layers):
    in_d = layers_dims[i]
    out_d = layers_dims[i+1]
    if i < num_layers-1:
        W = he_init(in_d, out_d)
    else:
        W = xavier_init(in_d, out_d)
    b = np.zeros((1, out_d))
    params[f"W{i+1}"] = W
    params[f"b{i+1}"] = b

optimizer = AdamOptimizer(params, lr=initial_lr)

history = {"train_loss": [], "val_loss": [], "val_acc": []}
best_val_loss = np.inf
patience = 0
es_counter = 0
lr = initial_lr

num_train = X_train.shape[0]
num_batches = int(np.ceil(num_train / batch_size))

print("Training started...")
for ep in range(epochs):

    perm = np.random.permutation(num_train)
    X_train_sh = X_train[perm]
    Y_train_sh = Y_train[perm]

    epoch_losses = []
    for b in tqdm(range(num_batches), desc=f"Epoch {ep+1}/{epochs}"):
        start = b * batch_size
        end = min(start + batch_size, num_train)
        Xb = X_train_sh[start:end]
        Yb = Y_train_sh[start:end]

        caches = {}
        A = Xb
        caches["A0"] = A

        for i in range(1, num_layers+1):
            Z = A.dot(params[f"W{i}"]) + params[f"b{i}"]
            caches[f"Z{i}"] = Z
            if i < num_layers:
                A = relu(Z)

                if use_dropout:
                    keep_prob = 1 - dropout_rates[i-1]
                    mask = (np.random.rand(*A.shape) < keep_prob) / keep_prob
                    A *= mask
                    caches[f"mask{i}"] = mask
            else:
                A = softmax(Z)
            caches[f"A{i}"] = A
        logits = caches[f"A{num_layers}"]
        loss_batch = -np.mean(np.sum(Yb * np.log(logits + 1e-12), axis=1))

        l2_pen = 0.0
        for i in range(1, num_layers+1):
            l2_pen += 0.5 * l2_lambda * np.sum(params[f"W{i}"]**2)
        loss_batch += l2_pen
        epoch_losses.append(loss_batch)

        grads = {}
        dA = logits - Yb  # shape (batch, num_classes)
        for i in range(num_layers, 0, -1):
            A_prev = caches[f"A{i-1}"]
            dZ = dA
            grads[f"dW{i}"] = A_prev.T.dot(dZ) / Xb.shape[0] + l2_lambda * params[f"W{i}"]
            grads[f"db{i}"] = np.sum(dZ, axis=0, keepdims=True) / Xb.shape[0]
            dA = dZ.dot(params[f"W{i}"].T)
            if i-1 >= 1:
                # apply dropout mask derivative if used
                if use_dropout:
                    mask = caches.get(f"mask{i-1}", None)
                    if mask is not None:
                        dA *= mask
                Z_prev = caches[f"Z{i-1}"]
                dA = dA * relu_deriv(Z_prev)

        # ---- Update parameters via Adam ----
        # collect grads in same structure as params
        grads_for_opt = {k.replace("d",""): v for k,v in grads.items()}
        optimizer.lr = lr  # update current lr
        optimizer.step(params, grads_for_opt)

    # end mini-batches
    epoch_loss = np.mean(epoch_losses)
    # validation performance on held-out test set
    # forward pass on X_test
    A = X_test
    for i in range(1, num_layers+1):
        Z = A.dot(params[f"W{i}"]) + params[f"b{i}"]
        if i < num_layers:
            A = relu(Z)
        else:
            A = softmax(Z)
    Yhat = A
    val_loss = -np.mean(np.sum(Y_test * np.log(Yhat + 1e-12), axis=1))
    val_loss += sum(0.5 * l2_lambda * np.sum(params[f"W{i}"]**2) for i in range(1, num_layers+1))
    y_pred = np.argmax(Yhat, axis=1)
    val_acc = accuracy(y_test, y_pred)

    history["train_loss"].append(epoch_loss)
    history["val_loss"].append(val_loss)
    history["val_acc"].append(val_acc)

    print(f"Epoch {ep+1}/{epochs} | train_loss: {epoch_loss:.4f} | val_loss: {val_loss:.4f} | val_acc: {val_acc:.4f} | lr: {lr:.6f}")

    # Learning rate scheduler: reduce on plateau
    if use_lr_scheduler:
        if val_loss + 1e-6 < best_val_loss:
            best_val_loss = val_loss
            patience = 0
        else:
            patience += 1
            if patience >= 2:
                # reduce lr
                lr = max(lr * reduce_factor, min_lr)
                print(f"Reducing lr to {lr:.6f}")
                patience = 0

    # Early stopping based on val_loss
    if val_loss < best_val_loss - 1e-9:
        best_val_loss = val_loss
        es_counter = 0
    else:
        es_counter += 1
    if es_counter >= early_stopping_patience:
        print("Early stopping triggered.")
        break

print("Training finished.")

A = X_test
for i in range(1, num_layers+1):
    Z = A.dot(params[f"W{i}"]) + params[f"b{i}"]
    if i < num_layers:
        A = relu(Z)
    else:
        A = softmax(Z)
Yhat_test = A
y_pred_test = np.argmax(Yhat_test, axis=1)
y_true_test = y_test

test_acc = accuracy(y_true_test, y_pred_test)
print(f"Test Accuracy: {test_acc:.4f}")

# classification report
print("\nClassification Report:")
print(classification_report(y_true_test, y_pred_test))

# confusion matrix (plot)
cm = confusion_matrix(y_true_test, y_pred_test)
plt.figure(figsize=(8,6))
sns.heatmap(cm, annot=True, fmt="d", cmap="Blues")
plt.xlabel("Predicted")
plt.ylabel("Actual")
plt.title("Confusion Matrix - Test Set")
plt.show()

plt.figure(figsize=(12,5))
plt.subplot(1,2,1)
plt.plot(history["train_loss"], label="train_loss")
plt.plot(history["val_loss"], label="val_loss")
plt.xlabel("Epochs")
plt.ylabel("Loss")
plt.legend()
plt.title("Loss curves")

plt.subplot(1,2,2)
plt.plot(history["val_acc"], label="val_acc", color="orange")
plt.xlabel("Epochs")
plt.ylabel("Accuracy")
plt.legend()
plt.title("Validation Accuracy")
plt.show()
A = X_test
for i in range(1, num_layers):
    Z = A.dot(params[f"W{i}"]) + params[f"b{i}"]
    A = relu(Z)
hidden_activations = A

# For visualization speed, take subset if large
n_vis = 2000
idxs = np.random.choice(hidden_activations.shape[0], size=min(n_vis, hidden_activations.shape[0]), replace=False)
H_sub = hidden_activations[idxs]
y_sub = y_true_test[idxs]

# Try t-SNE (slower) and fallback to PCA if t-SNE too slow
try:
    print("Computing t-SNE embedding (this can take ~30-60s)...")
    tsne = TSNE(n_components=2, perplexity=40, random_state=42, init='pca', n_iter=1000)
    H_emb = tsne.fit_transform(H_sub)
except Exception as e:
    print("t-SNE failed or too slow; falling back to PCA. Error:", e)
    pca = PCA(n_components=2)
    H_emb = pca.fit_transform(H_sub)

plt.figure(figsize=(8,6))
scatter = plt.scatter(H_emb[:,0], H_emb[:,1], c=y_sub, cmap='tab10', s=8)
plt.title("Embedding of penultimate hidden layer (t-SNE / PCA)")
plt.colorbar(scatter, ticks=range(10))
plt.show()


def show_samples(X_flat, y_true, y_pred, n=20):
    plt.figure(figsize=(12,6))
    indices = np.arange(X_flat.shape[0])
    # pick n random samples
    sel = np.random.choice(indices, size=n, replace=False)
    for i, idx in enumerate(sel):
        img = (X_flat[idx].reshape(28,28) * 255).astype(np.uint8)
        plt.subplot(4, 5, i+1)
        plt.imshow(img, cmap='gray')
        title = f"T:{y_true[idx]} P:{y_pred[idx]}"
        if y_true[idx] != y_pred[idx]:
            plt.title(title, color='red')
        else:
            plt.title(title, color='green')
        plt.axis('off')
    plt.tight_layout()
    plt.show()

show_samples(X_test, y_true_test, y_pred_test, n=20)

print("All done. ")
