
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
sns.set(style="whitegrid")

def sigmoid(x):
    return 1 / (1 + np.exp(-x))

def tanh(x):
    return np.tanh(x)

def relu(x):
    return np.maximum(0, x)

x = np.linspace(-10, 10, 500)

y_sigmoid = sigmoid(x)
y_tanh = tanh(x)
y_relu = relu(x)

plt.figure(figsize=(18,5))

# Sigmoid
plt.subplot(1, 3, 1)
plt.plot(x, y_sigmoid, color='blue', linewidth=2)
plt.title("Sigmoid Activation Function")
plt.xlabel("x")
plt.ylabel("f(x)")
plt.axhline(0, color='gray', linestyle="--")
plt.axvline(0, color='gray', linestyle="--")

# Tanh
plt.subplot(1, 3, 2)
plt.plot(x, y_tanh, color='green', linewidth=2)
plt.title("Tanh Activation Function")
plt.xlabel("x")
plt.ylabel("f(x)")
plt.axhline(0, color='gray', linestyle="--")
plt.axvline(0, color='gray', linestyle="--")

# ReLU
plt.subplot(1, 3, 3)
plt.plot(x, y_relu, color='red', linewidth=2)
plt.title("ReLU Activation Function")
plt.xlabel("x")
plt.ylabel("f(x)")
plt.axhline(0, color='gray', linestyle="--")
plt.axvline(0, color='gray', linestyle="--")

plt.tight_layout()
plt.show()

print("\n=== Activation Function Analysis ===")
print("Sigmoid: Output range is (0,1). Best for binary classification.")
print("Tanh: Output range is (-1,1). Better than sigmoid for zero-centered data.")
print("ReLU: Output range is [0,∞). Best for deep neural networks.")
